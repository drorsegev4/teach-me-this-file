# Required for AI calls. Never commit a real key.
GEMINI_API_KEY=

# Optional model override.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Local API port; the Vite dev proxy follows it. Hosts set their own PORT.
PORT=3001

# Optional. Set to "mock" to serve the saved lesson plan without calling Gemini.
AI_MODE=


# Optional estimated input budget per internal document-mapping call.
MATERIAL_TOKEN_BUDGET=4000
