{
  "name": "teach-me-this-file",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env --watch server/src/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:live": "node --env-file-if-exists=.env tests/live/manual.js",
    "plan:sample": "node --env-file-if-exists=.env tests/live/plan_sample.js",
    "eval:check": "node --env-file-if-exists=.env tests/evals/run-check.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "zod": "^4.1.0"
  }
}
